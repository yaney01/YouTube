#!name = 🍿️ DualSubs: ▶️ YouTube 双语字幕测试
#!desc = YouTube UI 自动翻译简中 + DualSubs 双语合成：第一行原文，第二行简体中文
#!author = yaney01, Maasea, DualSubs
#!homepage = https://github.com/yaney01/YouTube/tree/codex/fix-source-language-zh-hans
#!icon = https://raw.githubusercontent.com/yaney01/YouTube/codex/fix-source-language-zh-hans/src/assets/icon_rounded.png
#!category = 🍿️ DualSubs
#!version = 1.3.7-test.8

[Rule]
URL-REGEX,^https?:\/\/([\w-]+)\.googlevideo\.com\/initplayback(\?.*oad=.+)$,REJECT-TINYGIF

[Script]
📺 YouTube.Enhance.response.proto = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$, requires-body=1, max-size=-1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/yaney01/YouTube/codex/fix-source-language-zh-hans/vendor/YouTube.Enhance/youtube.response.js?v=2026.07.26-test.3, argument="{"captionLang":"zh-Hans","blockUpload":false,"blockImmersive":false,"blockShorts":false,"debug":false}"
📺 YouTube.Enhance.initplayback.request = type=http-request, pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*, requires-body=1, max-size=-1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/yaney01/YouTube/codex/fix-source-language-zh-hans/vendor/YouTube.Enhance/youtube.request.js?v=2026.07.26-test.2, argument="{"captionLang":"zh-Hans"}"
📺 YouTube.Enhance.log_event.request = type=http-request, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event, requires-body=1, max-size=-1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/yaney01/YouTube/codex/fix-source-language-zh-hans/vendor/YouTube.Enhance/youtube.request.js?v=2026.07.26-test.2
🍿️ DualSubs.YouTube.TimedText.request = type=http-request, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext(\?.+)?$, engine=webview, script-path=https://raw.githubusercontent.com/yaney01/YouTube/codex/fix-source-language-zh-hans/dist/request.bundle.js?v=1.3.7-test.8, argument=Type="Official"&Types="Translate"&Languages="AUTO,ZH-HANS"&AutoCC="false"&Position="Forward"&Vendor="Google"&ShowOnly="false"&LogLevel="WARN"&Storage="Argument"
🍿️ DualSubs.YouTube.Composite.TimedText.response = type=http-response, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=(Official|External), requires-body=1, script-path=https://raw.githubusercontent.com/yaney01/YouTube/codex/fix-source-language-zh-hans/vendor/DualSubs.Universal/Composite.Subtitles.response.bundle.js?v=1.7.5, argument=Type="Official"&Types="Translate"&Languages="AUTO,ZH-HANS"&AutoCC="false"&Position="Forward"&Vendor="Google"&ShowOnly="false"&LogLevel="WARN"&Storage="Argument"
🍿️ DualSubs.YouTube.Translate.TimedText.response = type=http-response, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=Translate, requires-body=1, script-path=https://raw.githubusercontent.com/yaney01/YouTube/codex/fix-source-language-zh-hans/vendor/DualSubs.Universal/Translate.response.bundle.js?v=1.7.5, argument=Type="Official"&Types="Translate"&Languages="AUTO,ZH-HANS"&AutoCC="false"&Position="Forward"&Vendor="Google"&ShowOnly="false"&LogLevel="WARN"&Storage="Argument"

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com, tv.youtube.com, youtubei.googleapis.com, -redirector*.googlevideo.com, *.googlevideo.com
