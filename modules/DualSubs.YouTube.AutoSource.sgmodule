#!name = 🍿️ DualSubs: ▶️ YouTube 双语字幕测试
#!desc = 使用 YouTube 自动翻译轨生成双语字幕：第一行源语言，第二行简体中文
#!openUrl = http://boxjs.com/#/app/DualSubs.YouTube
#!author = yaney01
#!homepage = https://github.com/yaney01/YouTube/tree/codex/fix-source-language-zh-hans
#!icon = https://raw.githubusercontent.com/yaney01/YouTube/codex/fix-source-language-zh-hans/src/assets/icon_rounded.png
#!category = 🍿️ DualSubs
#!version = 1.3.7-test.3
#!arguments = Type:"Official",Types:"Translate",Position:"Forward",Vendor:"Google",ShowOnly:false,LogLevel:"WARN"
#!arguments-desc = Type: 字幕类型（测试时请保持 Official）\nPosition: 源语言位置（Forward 为第一行）\nShowOnly: 是否只显示译文（测试时请保持 false）

[Rule]
URL-REGEX,^https?:\/\/([\w-]+)\.googlevideo\.com\/initplayback(\?.*oad=.+)$,REJECT-TINYGIF

[Script]
# YouTube
🍿️ DualSubs.YouTube.Player.request.json = type=http-request, pattern=^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$, requires-body=1, engine=webview, script-path=https://raw.githubusercontent.com/yaney01/YouTube/codex/fix-source-language-zh-hans/dist/request.bundle.js, argument=Type="{{{Type}}}"&Types="{{{Types}}}"&AutoCC="false"&Position="{{{Position}}}"&Vendor="{{{Vendor}}}"&ShowOnly="{{{ShowOnly}}}"&LogLevel="{{{LogLevel}}}"&Storage="Argument"
🍿️ DualSubs.YouTube.Player.response.json = type=http-response, pattern=^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$, requires-body=1, engine=webview, script-path=https://raw.githubusercontent.com/yaney01/YouTube/codex/fix-source-language-zh-hans/dist/response.bundle.js, argument=Type="{{{Type}}}"&Types="{{{Types}}}"&AutoCC="false"&Position="{{{Position}}}"&Vendor="{{{Vendor}}}"&ShowOnly="{{{ShowOnly}}}"&LogLevel="{{{LogLevel}}}"&Storage="Argument"
🍿️ DualSubs.YouTube.Player.request.proto = type=http-request, pattern=^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/yaney01/YouTube/codex/fix-source-language-zh-hans/dist/request.bundle.js, argument=Type="{{{Type}}}"&Types="{{{Types}}}"&AutoCC="false"&Position="{{{Position}}}"&Vendor="{{{Vendor}}}"&ShowOnly="{{{ShowOnly}}}"&LogLevel="{{{LogLevel}}}"&Storage="Argument"
🍿️ DualSubs.YouTube.Player.response.proto = type=http-response, pattern=^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/yaney01/YouTube/codex/fix-source-language-zh-hans/dist/response.bundle.js, argument=Type="{{{Type}}}"&Types="{{{Types}}}"&AutoCC="false"&Position="{{{Position}}}"&Vendor="{{{Vendor}}}"&ShowOnly="{{{ShowOnly}}}"&LogLevel="{{{LogLevel}}}"&Storage="Argument"
🍿️ DualSubs.YouTube.GetWatch.response.proto = type=http-response, pattern=^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_watch(\?.+)?$, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/yaney01/YouTube/codex/fix-source-language-zh-hans/dist/response.bundle.js, argument=Type="{{{Type}}}"&Types="{{{Types}}}"&AutoCC="false"&Position="{{{Position}}}"&Vendor="{{{Vendor}}}"&ShowOnly="{{{ShowOnly}}}"&LogLevel="{{{LogLevel}}}"&Storage="Argument"
🍿️ DualSubs.YouTube.TimedText.request = type=http-request, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext(\?.+)?$, engine=webview, script-path=https://raw.githubusercontent.com/yaney01/YouTube/codex/fix-source-language-zh-hans/dist/request.bundle.js, argument=Type="{{{Type}}}"&Types="{{{Types}}}"&AutoCC="false"&Position="{{{Position}}}"&Vendor="{{{Vendor}}}"&ShowOnly="{{{ShowOnly}}}"&LogLevel="{{{LogLevel}}}"&Storage="Argument"
🍿️ DualSubs.YouTube.Composite.TimedText.response = type=http-response, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=(Official|External), requires-body=1, script-path=https://github.com/DualSubs/Universal/releases/latest/download/Composite.Subtitles.response.bundle.js, argument=Type="{{{Type}}}"&Types="{{{Types}}}"&AutoCC="false"&Position="{{{Position}}}"&Vendor="{{{Vendor}}}"&ShowOnly="{{{ShowOnly}}}"&LogLevel="{{{LogLevel}}}"&Storage="Argument"
🍿️ DualSubs.YouTube.Translate.TimedText.response = type=http-response, pattern=^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=Translate, requires-body=1, script-path=https://github.com/DualSubs/Universal/releases/latest/download/Translate.response.bundle.js, argument=Type="{{{Type}}}"&Types="{{{Types}}}"&AutoCC="false"&Position="{{{Position}}}"&Vendor="{{{Vendor}}}"&ShowOnly="{{{ShowOnly}}}"&LogLevel="{{{LogLevel}}}"&Storage="Argument"

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com, tv.youtube.com, youtubei.googleapis.com, -redirector*.googlevideo.com, *.googlevideo.com
