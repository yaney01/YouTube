#!name = 📺 YouTube Enhance 简体中文基线测试
#!desc = 内置 YouTube Enhance 播放链路，在自动翻译菜单补充中文（简体），不直接请求翻译字幕
#!author = Maasea, yaney01
#!homepage = https://github.com/yaney01/YouTube/tree/codex/surge-youtube-bilingual-zh-hans
#!category = 📺 YouTube
#!version = 2026.07.26-test.3

[Rule]
URL-REGEX,^https?:\/\/([\w-]+)\.googlevideo\.com\/initplayback(\?.*oad=.+)$,REJECT-TINYGIF

[Script]
📺 YouTube.Enhance.response.proto = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$, requires-body=1, max-size=-1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/yaney01/YouTube/codex/surge-youtube-bilingual-zh-hans/vendor/YouTube.Enhance/youtube.response.js?v=2026.07.26-test.3, argument="{"captionLang":"zh-Hans","blockUpload":false,"blockImmersive":false,"blockShorts":false,"debug":false}"
📺 YouTube.Enhance.initplayback.request = type=http-request, pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*, requires-body=1, max-size=-1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/yaney01/YouTube/codex/surge-youtube-bilingual-zh-hans/vendor/YouTube.Enhance/youtube.request.js?v=2026.07.26-test.2, argument="{"captionLang":"zh-Hans"}"
📺 YouTube.Enhance.log_event.request = type=http-request, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event, requires-body=1, max-size=-1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/yaney01/YouTube/codex/surge-youtube-bilingual-zh-hans/vendor/YouTube.Enhance/youtube.request.js?v=2026.07.26-test.2

[MITM]
hostname = %APPEND% youtubei.googleapis.com, -redirector*.googlevideo.com, *.googlevideo.com
